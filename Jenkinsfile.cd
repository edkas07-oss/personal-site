pipeline {

    /**************************************************************************
     * Deployment Agent
     *
     * Pipeline CD berjalan pada host runtime melalui node builder-01.
     * Agent menggunakan rootless Podman user yang memiliki container,
     * network, image, dan volume aplikasi.
     **************************************************************************/

    agent {
        label 'builder-01'
    }

    /**************************************************************************
     * Pipeline Safety
     *
     * Hanya satu deployment boleh mengubah container dan volume aplikasi
     * pada satu waktu. Timeout mencegah job menunggu tanpa batas.
     **************************************************************************/

    options {
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
    }

    /**************************************************************************
     * Deployment Parameter
     *
     * Artifact dipilih secara eksplisit agar deployment dapat ditelusuri ke
     * nomor build CI yang menghasilkan artifact tersebut.
     **************************************************************************/

    parameters {
        string(
            name: 'personal-site-59.tar.gz',
            defaultValue: '',
            description: 'MinIO artifact name, for example personal-site-57.tar.gz',
            trim: true
        )
    }

    /**************************************************************************
     * Shared Configuration
     *
     * Setiap shell stage membaca konfigurasi non-secret dari
     * deployment/CONFIG. Credential MinIO tetap dikelola oleh Jenkins.
     **************************************************************************/

    stages {

        /**********************************************************************
         * Verify Deployment Agent
         *
         * Memastikan konfigurasi tersedia dan rootless Podman memiliki image
         * serta network yang dibutuhkan oleh deployment.
         **********************************************************************/

        stage('Verify Deployment Agent') {
            steps {
                sh '''
                    set -eu

                    . deployment/CONFIG

                    test "$(id -u)" -ne 0
                    test "$(podman info --format '{{.Host.Security.Rootless}}')" = 'true'
                    podman image exists "$NGINX_IMAGE"
                    podman network exists "$PODMAN_NETWORK"
                '''
            }
        }

        /**********************************************************************
         * Validate Parameters
         *
         * Menolak input kosong, path, dan nama artifact di luar format yang
         * dihasilkan oleh pipeline CI.
         **********************************************************************/

        stage('Validate Parameters') {
            steps {
                sh '''
                    set -eu

                    . deployment/CONFIG

                    printf '%s\n' "$ARTIFACT_NAME" \
                        | grep -Eq "^${ARTIFACT_PREFIX}-[0-9]+\\.tar\\.gz$" \
                        || {
                            echo "Invalid artifact name: $ARTIFACT_NAME" >&2
                            exit 1
                        }
                '''
            }
        }

        /**********************************************************************
         * Download Artifact
         *
         * MinIO Client dijalankan sebagai ephemeral container. Credential
         * di-inject oleh Jenkins hanya selama stage download.
         **********************************************************************/

        stage('Download Artifact') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'minio-root',
                        usernameVariable: 'MINIO_USER',
                        passwordVariable: 'MINIO_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        . deployment/CONFIG
                        rm -f "$ARTIFACT_NAME"

                        podman run \
                            --rm \
                            --volume "$WORKSPACE:/workspace:Z" \
                            --workdir /workspace \
                            --env ARTIFACT_NAME \
                            --env MINIO_ALIAS \
                            --env MINIO_BUCKET \
                            --env MINIO_URL \
                            --env MINIO_USER \
                            --env MINIO_PASSWORD \
                            --entrypoint /bin/sh \
                            "$MC_IMAGE" \
                            -ec '
                                mc alias set "$MINIO_ALIAS" "$MINIO_URL" "$MINIO_USER" "$MINIO_PASSWORD"
                                mc stat "$MINIO_ALIAS/$MINIO_BUCKET/$ARTIFACT_NAME"
                                mc cp "$MINIO_ALIAS/$MINIO_BUCKET/$ARTIFACT_NAME" "/workspace/$ARTIFACT_NAME"
                            '

                        test -s "$ARTIFACT_NAME"
                    '''
                }
            }
        }

        /**********************************************************************
         * Verify Artifact
         *
         * Archive diperiksa sebelum ekstraksi. Seluruh entry harus berada di
         * bawah public/ dan tidak boleh menggunakan absolute atau parent path.
         **********************************************************************/

        stage('Verify Artifact') {
            steps {
                sh '''
                    set -eu

                    rm -rf deploy-staging deployment-state
                    mkdir -p deploy-staging deployment-state

                    tar -tzf "$ARTIFACT_NAME" > deployment-state/archive.list

                    awk '
                        substr($0, 1, 1) == "/" { invalid = 1 }
                        /(^|[/])[.][.]($|[/])/ { invalid = 1 }
                        $0 != "public" && $0 != "public/" && $0 !~ /^public[/]/ { invalid = 1 }
                        END { exit invalid }
                    ' deployment-state/archive.list

                    tar \
                        --extract \
                        --gzip \
                        --file "$ARTIFACT_NAME" \
                        --directory deploy-staging \
                        --no-same-owner \
                        --no-same-permissions

                    test -s deploy-staging/public/index.html
                '''
            }
        }

        /**********************************************************************
         * Prepare Rollback
         *
         * Konten aktif hanya disimpan jika volume sudah memiliki index.html.
         * Pada deployment pertama tidak ada rollback target palsu.
         **********************************************************************/

        stage('Prepare Rollback') {
            steps {
                sh '''
                    set -eu

                    . deployment/CONFIG
                    umask 077
                    podman volume create "$CONTENT_VOLUME" >/dev/null

                    podman run \
                        --rm \
                        --volume "$CONTENT_VOLUME:/source:ro" \
                        --volume "$WORKSPACE/deployment-state:/backup:Z" \
                        --entrypoint /bin/sh \
                        "$NGINX_IMAGE" \
                        -ec '
                            if [ -s /source/index.html ]; then
                                tar -czf /backup/previous-content.tar.gz -C /source .
                                touch /backup/rollback-available
                            fi
                        '
                '''
            }
        }

        /**********************************************************************
         * Populate Content Volume
         *
         * Container aktif dihentikan sebelum volume dibersihkan. Ephemeral
         * loader mengisi static content dan kemudian langsung dihapus.
         **********************************************************************/

        stage('Populate Content Volume') {
            steps {
                sh '''
                    set -eu

                    . deployment/CONFIG

                    podman rm -f "$CONTAINER_NAME" 2>/dev/null || true
                    podman rm -f "$LOADER_CONTAINER" 2>/dev/null || true
                    touch deployment-state/volume-update-started

                    podman run \
                        --rm \
                        --volume "$CONTENT_VOLUME:/target" \
                        --entrypoint /bin/sh \
                        "$NGINX_IMAGE" \
                        -ec 'find /target -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +'

                    podman create \
                        --name "$LOADER_CONTAINER" \
                        --volume "$CONTENT_VOLUME:/var/www/html" \
                        --entrypoint /bin/sh \
                        "$NGINX_IMAGE" \
                        -c 'true'

                    podman cp deploy-staging/public/. "$LOADER_CONTAINER:/var/www/html/"
                    podman rm "$LOADER_CONTAINER"

                    podman run \
                        --rm \
                        --volume "$CONTENT_VOLUME:/target" \
                        --env ARTIFACT_NAME \
                        --entrypoint /bin/sh \
                        "$NGINX_IMAGE" \
                        -ec 'printf "%s\n" "$ARTIFACT_NAME" > /target/.artifact-name'
                '''
            }
        }

        /**********************************************************************
         * Deploy NGINX
         *
         * Application deployment script menjalankan generic NGINX image
         * menggunakan parameter dari deployment/CONFIG.
         **********************************************************************/

        stage('Deploy NGINX') {
            steps {
                sh '''
                    set -eu
                    ./deployment/deploy.sh
                '''
            }
        }

        /**********************************************************************
         * Validate Deployment
         *
         * Pipeline menunggu HTTP endpoint dan container health check, lalu
         * memastikan content volume dipasang read-only.
         **********************************************************************/

        stage('Validate Deployment') {
            steps {
                sh '''
                    set -eu

                    . deployment/CONFIG

                    attempt=1
                    while [ "$attempt" -le 12 ]; do
                        if curl --fail --silent --show-error \
                            "http://127.0.0.1:$HTTP_HOST_PORT/" >/dev/null; then
                            break
                        fi

                        if [ "$attempt" -eq 12 ]; then
                            podman logs "$CONTAINER_NAME"
                            exit 1
                        fi

                        sleep 5
                        attempt=$((attempt + 1))
                    done

                    attempt=1
                    while [ "$attempt" -le 18 ]; do
                        health_status=$(podman inspect "$CONTAINER_NAME" \
                            --format '{{.State.Health.Status}}')

                        if [ "$health_status" = 'healthy' ]; then
                            break
                        fi

                        if [ "$health_status" = 'unhealthy' ] || [ "$attempt" -eq 18 ]; then
                            podman logs "$CONTAINER_NAME"
                            exit 1
                        fi

                        sleep 5
                        attempt=$((attempt + 1))
                    done

                    test "$(podman inspect "$CONTAINER_NAME" \
                        --format '{{range .Mounts}}{{if eq .Destination "/var/www/html"}}{{.RW}}{{end}}{{end}}')" = 'false'
                '''
            }
        }
    }

    /**************************************************************************
     * Post Actions
     *
     * Failure memulihkan backup jika runtime sebelumnya memang tersedia.
     * Always menghapus helper container dan temporary deployment files.
     **************************************************************************/

    post {
        failure {
            sh '''
                set +e

                if [ ! -f deployment/CONFIG ]; then
                    exit 0
                fi

                . deployment/CONFIG

                if [ -f deployment-state/volume-update-started ] \
                    && [ -f deployment-state/rollback-available ] \
                    && [ -s deployment-state/previous-content.tar.gz ]; then
                    echo 'Deployment failed; restoring previous volume content.'

                    podman rm -f "$CONTAINER_NAME" 2>/dev/null || true
                    podman rm -f "$LOADER_CONTAINER" 2>/dev/null || true

                    podman run \
                        --rm \
                        --volume "$CONTENT_VOLUME:/target" \
                        --volume "$WORKSPACE/deployment-state:/backup:ro,Z" \
                        --entrypoint /bin/sh \
                        "$NGINX_IMAGE" \
                        -ec '
                            find /target -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
                            tar -xzf /backup/previous-content.tar.gz -C /target
                        '

                    ./deployment/deploy.sh
                else
                    echo 'No previous runtime content is available for rollback.'
                fi
            '''
        }

        always {
            sh '''
                if [ -f deployment/CONFIG ]; then
                    . deployment/CONFIG
                else
                    LOADER_CONTAINER=personal-site-volume-loader
                fi

                podman rm -f "$LOADER_CONTAINER" 2>/dev/null || true
                rm -rf deploy-staging deployment-state
                rm -f personal-site-*.tar.gz
            '''
        }
    }
}
